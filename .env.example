# Browser requests use the Next.js same-origin proxy.
NEXT_PUBLIC_API_URL=/backend

# Server-side destination used by the Next.js rewrite.
API_PROXY_TARGET=http://127.0.0.1:8000
# Production: API_PROXY_TARGET=https://trainsyt.speqlink.com

NEXT_PUBLIC_APP_NAME=Training Platform
NEXT_PUBLIC_APP_VERSION=1.0.0
